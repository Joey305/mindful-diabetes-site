# Heroku deployment exclusions.
# Large media should live in external asset storage, not in the app slug.
*.wav
*.mp3
*.mp4
*.mov
*.m4a
*.avi
*.zip

# Local development and cache artifacts
.env
.env.*
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.DS_Store
._*

