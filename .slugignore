mindful_diabetes_wp_parse_outputs/wp_migration_outputs/*.csv
mindful_diabetes_wp_parse_outputs/wp_migration_outputs/wordpress_*.json
static/uploads/trustedlogin-logs/
static/uploads/mailchimp-for-wp/debug-log.php
*.log
