PAYPAL_HOSTED_BUTTON_ID=5BM2YU7LNZDVJ

# Mailchimp
# Create/copy these from your Mailchimp account when you are ready.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=

# Optional. If blank, the app uses the suffix from MAILCHIMP_API_KEY, like us21.
MAILCHIMP_SERVER_PREFIX=

# Optional comma-separated tags applied to new subscribers.
MAILCHIMP_TAGS=Mindful Diabetes Subscribers

# Cloudflare Turnstile bot protection for newsletter forms.
# Site key is public. Secret key must stay private.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
