PAYPAL_HOSTED_BUTTON_ID=5BM2YU7LNZDVJ

# Flask sessions and admin dashboard.
# Generate a long random value for production.
SECRET_KEY=
ADMIN_EMAIL=jmschulz@mindfuldiabetes.org
ADMIN_EMAIL_FROM=Mindful Diabetes <login@auth.mindfuldiabetes.org>
BREVO_API_KEY=

# Optional. Add later when you want admin activity history to persist on Heroku.
DATABASE_URL=

# Google Ads conversion tracking. The conversion ID is public tag configuration.
GOOGLE_ADS_CONVERSION_ID=AW-11435654295

# Optional JSON map from first-party event names to Google Ads conversion labels.
# Example: {"resource_pdf_download":"abc123ConversionLabel","paypal_click":"AW-11435654295/xyz789Label"}
GOOGLE_ADS_CONVERSION_ACTIONS_JSON={}

# Optional local development paths for admin content.
CMS_DATA_PATH=
CMS_LOCAL_UPLOAD_ROOT=

# Mailchimp
# Create/copy these from your Mailchimp account when you are ready.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=

# Optional. If blank, the app uses the suffix from MAILCHIMP_API_KEY, like us21.
MAILCHIMP_SERVER_PREFIX=

# Optional comma-separated tags applied to new subscribers.
MAILCHIMP_TAGS=Mindful Diabetes Subscribers

# Cloudflare Turnstile bot protection for newsletter forms.
# Site key is public. Secret key must stay private.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
